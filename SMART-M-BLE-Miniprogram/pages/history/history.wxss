.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

.head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f6feb;
}

.head-meta {
  font-size: 22rpx;
  color: #888;
}

.head-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.btn-row {
  display: flex;
  margin-top: 16rpx;
}

.btn {
  border-radius: 12rpx;
  font-size: 28rpx;
  margin: 0 8rpx 0 0;
}

.empty {
  color: #999;
  font-size: 26rpx;
  text-align: center;
  padding: 40rpx 0;
}

.table-scroll {
  max-height: 80vh;
}

.table {
  width: 100%;
  font-size: 20rpx;
}

.tr {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f1f4;
  padding: 10rpx 0;
}

.tr.th {
  background: #f5f6fa;
  color: #888;
  font-weight: 600;
  position: sticky;
  top: 0;
}

.td {
  width: 90rpx;
  text-align: center;
  flex-shrink: 0;
  word-break: break-all;
}

.td.time {
  width: 140rpx;
  text-align: left;
  color: #999;
}

.txt-green {
  color: #1a7f37;
}

.txt-red {
  color: #cf222e;
}

.txt-orange {
  color: #bc4c00;
}

.txt-gray {
  color: #999;
}
