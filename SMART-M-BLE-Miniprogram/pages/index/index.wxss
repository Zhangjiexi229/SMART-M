/* 首页样式 */
.status-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-green {
  background: #2ea44f;
}

.dot-gray {
  background: #c0c4cc;
}

.status-rssi {
  margin-left: 24rpx;
  color: #888;
}

.status-time {
  margin-left: 24rpx;
  color: #888;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 8rpx;
}

.ctrl-label {
  font-size: 24rpx;
  color: #888;
  margin-right: 12rpx;
}

.device-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.device-item:last-child {
  border-bottom: none;
}

.device-name {
  font-size: 30rpx;
  font-weight: 500;
}

.device-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  word-break: break-all;
}

.empty {
  color: #999;
  font-size: 26rpx;
  text-align: center;
  padding: 30rpx 0;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 33.33%;
  box-sizing: border-box;
  padding: 16rpx 0;
  text-align: center;
}

.cell-value {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1f6feb;
}

.cell-label {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.state-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin: 4rpx 8rpx 4rpx 0;
  background: #eaecef;
  color: #555;
}

.tag-green {
  background: #d3f1dc;
  color: #1a7f37;
}

.tag-red {
  background: #fde3e5;
  color: #cf222e;
}

.tag-orange {
  background: #fff1e0;
  color: #bc4c00;
}

.log-box {
  max-height: 300rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 12rpx;
}

.log-line {
  font-size: 20rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
}
