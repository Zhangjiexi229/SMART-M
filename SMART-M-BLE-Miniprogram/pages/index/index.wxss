/* 首页样式 */
.status-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-green {
  background: #2ea44f;
}

.dot-gray {
  background: #c0c4cc;
}

.status-rssi {
  margin-left: 24rpx;
  color: #888;
}

.status-time {
  margin-left: 24rpx;
  color: #888;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 8rpx;
}

.ctrl-label {
  font-size: 24rpx;
  color: #888;
  margin-right: 12rpx;
}

.device-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.device-item:last-child {
  border-bottom: none;
}

.device-name {
  font-size: 30rpx;
  font-weight: 500;
}

.device-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  word-break: break-all;
}

.empty {
  color: #999;
  font-size: 26rpx;
  text-align: center;
  padding: 30rpx 0;
}

/* 显示范围开关 */
.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.filter-label {
  font-size: 22rpx;
  color: #888;
  margin-left: 12rpx;
  flex: 1;
  line-height: 1.5;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 33.33%;
  box-sizing: border-box;
  padding: 16rpx 0;
  text-align: center;
}

.cell-value {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1f6feb;
}

.cell-dim {
  color: #999;
}

.cell-label {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

/* 告警 / 诊断卡片 */
.card-warn {
  border-left: 8rpx solid #cf222e;
}

.card-diag {
  border-left: 8rpx solid #bc4c00;
}

.warn-title {
  color: #cf222e;
}

.diag-title {
  color: #bc4c00;
}

/* 告警/诊断明细：每项单独一行 */
.warn-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.warn-label {
  width: 110rpx;
  font-size: 24rpx;
  color: #888;
  flex-shrink: 0;
}

.warn-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.diag-msg {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

/* 阈值设置 */
.th-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.th-label {
  width: 200rpx;
  font-size: 26rpx;
  color: #555;
}

.th-input {
  flex: 1;
  background: #f5f6fa;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  font-size: 28rpx;
}

.th-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.state-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

/* 继电器 / 警告 / 诊断：每项独立一行 */
.state-line {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.state-label {
  width: 110rpx;
  font-size: 24rpx;
  color: #888;
  flex-shrink: 0;
}

/* 按钮按下（深色）/ 恢复原样（原色）两种状态 */
.btn-pressed {
  transform: scale(0.96);
}

.btn-green.btn-pressed {
  background: #1e7e34;
}

.btn-red.btn-pressed {
  background: #a81d26;
}

.btn-gray.btn-pressed {
  background: #9aa0a6;
}

.btn-primary.btn-pressed {
  background: #1a5c8a;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin: 4rpx 8rpx 4rpx 0;
  background: #eaecef;
  color: #555;
}

.tag-green {
  background: #d3f1dc;
  color: #1a7f37;
}

.tag-red {
  background: #fde3e5;
  color: #cf222e;
}

.tag-orange {
  background: #fff1e0;
  color: #bc4c00;
}

.log-box {
  max-height: 300rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 12rpx;
}

.log-line {
  font-size: 20rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
}
